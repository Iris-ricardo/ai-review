# .env.example —— 本机（Windows）运行模板：setup_windows.ps1 会复制为 backend\.env。
# Docker 部署改用 .env.docker.example → .env（容器内路径不同）。
# 默认取“生产安全”值：不建演示账号、首登强制改密、禁止材料外发；不得写入真实密钥（占位符用 replace-with-...）。

# ── App ──
APP_NAME=AI 项目申报书智能形式审查系统
APP_VERSION=1.4.0
APP_BUILD_ID=20260721-strict-approval
DEBUG=false
ACCESS_TOKEN=replace-with-a-random-access-token
ADMIN_TOKEN=replace-with-a-separate-admin-token
AUTH_SECRET=replace-with-a-random-session-signing-secret
RATE_LIMIT_PER_MINUTE=120
# 登录接口按账号维度滑动窗口限速（另有 IP+路径全局限速）
LOGIN_USER_RATE_LIMIT_PER_MINUTE=20
LOG_FILE=./server.runtime.log

# ── 访问控制与账号初始化（生产安全默认；R13：这些键需能从宿主传入容器）──
AUTH_REQUIRED=true
# false = 空库不创建源码可推导密码的演示账号
AUTH_CREATE_DEMO_USERS=false
# true = 演示账号与初始超管首登强制改密
AUTH_FORCE_DEMO_PASSWORD_CHANGE=true
# 空库首启的唯一超管；必须随机且非空，留空则无人能登录
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# ── 演示 / 比赛环境：默认关闭，演示后请改回；开启即承担对应风险 ──
# AUTH_CREATE_DEMO_USERS=true 建 5 个固定口令账号（仅限本机离线，联网/对外禁用）
# AUTH_FORCE_DEMO_PASSWORD_CHANGE=false 演示免改密（口令长期有效）
# AI_EGRESS_ENABLED=true 允许材料正文外发（需已获授权，且 LLM_BASE_URL/LLM_API_KEY 指向合规端点）

# ── Durable SQLite task store（Docker 改为 sqlite:////data/review.db）──
DATABASE_URL=sqlite:///./review.db
DATABASE_ECHO=false
TASK_MAX_WORKERS=2
TASK_QUEUE_CAPACITY=64
TASK_TIMEOUT_SECONDS=900
RULE_TIMEOUT_SECONDS=180
TASK_HEARTBEAT_TIMEOUT_SECONDS=180
DATA_RETENTION_DAYS=30

# ── LLM (OpenAI-compatible) ──
# /api/health 的 llm_configured 只判断 LLM_API_KEY 是否非空，占位符也会算“已配置”
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=kimi-k3
LLM_TIMEOUT=60
LLM_CONNECT_TIMEOUT=10
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=1
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_PROMPT_CHARS=16000
LLM_MAX_CALLS_PER_TASK=8
LLM_TEMPERATURE=0
# 部署级外发总开关：false = 全局禁止（优先于用户勾选与 LLM_API_KEY）
AI_EGRESS_ENABLED=false

# ── File storage（Docker 改为 /data/uploads、/data/outputs）──
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE_MB=50
MIN_EXTRACTED_TEXT_CHARS=80

# ── LibreOffice（Docker 改为 /usr/bin/soffice）──
SOFFICE_PATH=
OCR_ENABLED=true
OCR_LANGUAGE=chi_sim+eng
OCR_DPI=150
OCR_MIN_PAGE_CHARS=20
OCR_MAX_PAGES=30
# 留空 = PyMuPDF 调 `tesseract --list-langs` 自动探测语言目录
TESSDATA_PREFIX=

# ── Rules（Docker 改为 /app/rules）──
RULES_DIR=../rules

# ── 中文报告字体（留空按平台候选查找；Docker 由 compose 注入镜像内已固化字体）──
REPORT_FONT_PATH=
