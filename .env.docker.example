# .env.docker.example —— Docker Compose 部署模板（宿主侧插值变量，放在项目根目录）。
# 用法：Copy-Item .env.docker.example .env → 填下面 3 个必填密钥（需要 AI 再填 LLM_API_KEY）→ docker compose up --build -d
# 注意：compose 只读项目根目录的 .env（不读 backend\.env）；路径必须是容器内绝对路径（/data、/app/rules、/usr/bin/soffice），
# 用本机相对路径会把上传/输出落到容器可写层，容器重建即丢数据；默认生产安全，且不要提交真实密钥。

# ── 必填：三个凭据（未设置时 compose 直接拒绝启动） ──
ACCESS_TOKEN=replace-with-a-random-access-token
ADMIN_TOKEN=replace-with-a-separate-admin-token
AUTH_SECRET=replace-with-a-random-session-signing-secret

# ── 访问控制与账号初始化（生产安全默认，R13） ──
AUTH_REQUIRED=true
AUTH_CREATE_DEMO_USERS=false
AUTH_FORCE_DEMO_PASSWORD_CHANGE=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
# 首次部署必填：空库首启用它创建唯一超管（首登强制改密）；留空则无人能登录，请用随机值
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# ── AI 外发总开关（生产安全默认：关闭） ──
# false = 后端强制拒绝把材料正文发给外部模型；要真实 AI 审核需改 true 并确认材料已获外发授权
AI_EGRESS_ENABLED=false
LLM_BASE_URL=https://api.moonshot.cn/v1
# /api/health 的 llm_configured 只判断 LLM_API_KEY 是否非空，占位符也会算“已配置”
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=kimi-k3

# ── 容器内路径 / 运行参数（通常保持默认；compose 内已有同样兜底默认值） ──
DATABASE_URL=sqlite:////data/review.db
RULES_DIR=/app/rules
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
SOFFICE_PATH=/usr/bin/soffice
MAX_UPLOAD_SIZE_MB=50
OCR_ENABLED=true
OCR_LANGUAGE=chi_sim+eng
OCR_DPI=150
# 留空 = PyMuPDF 调 `tesseract --list-langs` 自动探测镜像内语言目录
TESSDATA_PREFIX=
# 留空 = 用 compose 默认 /usr/local/share/fonts/review/review-cjk.ttc（Dockerfile 构建期已验证）
REPORT_FONT_PATH=
LOG_FILE=

# ── 演示 / 比赛环境：默认关闭，演示后改回（原因与代价见 .env.example 同段） ──
# AUTH_CREATE_DEMO_USERS=true 建固定口令演示账号（仅限离线）
# AUTH_FORCE_DEMO_PASSWORD_CHANGE=false 演示免改密
# AI_EGRESS_ENABLED=true 允许材料正文外发（需已获授权）
